# Cloudinary Media Storage Configuration (Optional - set via Secrets panel or .env)
# Never expose CLOUDINARY_API_SECRET in Android client code; use a backend signing endpoint.
CLOUDINARY_CLOUD_NAME=MY_CLOUDINARY_CLOUD_NAME
CLOUDINARY_UPLOAD_PRESET=MY_CLOUDINARY_UPLOAD_PRESET
CLOUDINARY_SIGNING_ENDPOINT=MY_CLOUDINARY_SIGNING_ENDPOINT

# WebRTC STUN/TURN Configuration (Optional - Google public STUN is configured by default)
TURN_SERVER_URL=MY_TURN_SERVER_URL
TURN_USERNAME=MY_TURN_USERNAME
TURN_CREDENTIAL=MY_TURN_CREDENTIAL
