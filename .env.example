# Supabase Storage Configuration (Set via AI Studio Secrets panel or .env)
# Never expose SUPABASE_SERVICE_ROLE_KEY in Android client code; keep it strictly in backend functions.
SUPABASE_URL=MY_SUPABASE_URL
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY
SUPABASE_MEDIA_BRIDGE_URL=MY_SUPABASE_MEDIA_BRIDGE_URL

# WebRTC STUN/TURN Configuration (Optional - Google public STUN is configured by default)
TURN_SERVER_URL=MY_TURN_SERVER_URL
TURN_USERNAME=MY_TURN_USERNAME
TURN_CREDENTIAL=MY_TURN_CREDENTIAL
